{
  "name": "Tag protection",
  "target": "tag",
  "conditions": {
    "ref_name": {
      "include": ["refs/tags/v*"],
      "exclude": []
    }
  },
  "rules": [
    {
      "type": "non_fast_forward"
    },
    {
      "type": "deletion"
    }
  ],
  "bypass_actors": [
    {
      "actor_id": 0,
      "actor_type": "RepositoryRole",
      "bypass_mode": "always"
    }
  ],
  "enforcement": "active"
}
