# Public browser configuration for the Aricie Supabase project.
# These VITE_* values are embedded in the static bundle during `bun run build`.
# The anon key is public; NEVER put the Supabase service_role key here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
