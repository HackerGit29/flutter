        <mxCell id="e-net-broker" value="MQTTS 8883 / WSS 8084 (TLS)&#10;bo&#238;tiers : pub telemetry &#183; status &#183; ack&#10;worker : pub cmd &#183; app : souscrit telemetry" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=none;strokeWidth=2;fontSize=11;fontColor=#b85450;" edge="1" parent="1" source="internet" target="broker">
