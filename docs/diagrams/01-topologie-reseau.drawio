        <!-- ===== Legende ===== -->
        <mxCell id="legende" value="L&#233;gende&#10;&#8226; Liens annot&#233;s : protocole + port. Tout le trafic est chiffr&#233; (TLS).&#10;&#8226; Traits pleins = acc&#232;s depuis le site utilisateur ; pointill&#233;s = &#233;changes cloud-&#224;-cloud (backbone).&#10;&#8226; Contr&#244;le possible depuis n&#8217;importe o&#249; : app et bo&#238;tier se rejoignent via le cloud &#8212; aucun port ouvert sur la box.&#10;&#8226; Topics MQTT : aricie/v1/boxes/{uid}/telemetry | relays/{i}/cmd | relays/{i}/ack&#10;&#8226; Commande app &#8594; file device_commands &#8594; Worker &#8594; broker (jamais en direct)." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=11;fillColor=#f5f5f5;strokeColor=#999999;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="440" y="560" width="420" height="175" as="geometry" />
        </mxCell>

