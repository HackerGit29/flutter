        <mxCell id="e-bridge-supabase" value="HTTPS 443 (tunnel cloudflared)&#10;POST /chat/completions &#8212; provider n&#176;1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=none;strokeWidth=2;dashed=1;fontSize=11;fontStyle=2;" edge="1" parent="1" source="bridge" target="supabase">
