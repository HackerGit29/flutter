        <mxCell id="e-supabase-ia" value="HTTPS 443 (Edge Functions)&#10;cha&#238;ne 1 &#8594; 2 &#8594; 3, bascule sur panne" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=none;strokeWidth=2;dashed=1;fontSize=11;" edge="1" parent="1" source="zone-supabase" target="zone-ia">
          <mxGeometry relative="1" as="geometry">
